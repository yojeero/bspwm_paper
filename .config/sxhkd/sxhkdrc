
# ------------------------------------
# run sxhkd via POSIX/Bash rules
# ------------------------------------

SXHKD_SHELL = /bin/bash

# ------------------------------------
# system
# ------------------------------------

super + Return
	alacritty

super + d
	rofi -show drun

super + e
	thunar

super + x
	mousepad

Print
	maim -u | tee "$HOME/Screen/pic_$(date +%F_%T).png"

# -------------------------------------
# POLYBAR
# -------------------------------------

# hide/show polybar
super + b
	polybar-msg cmd toggle

# ---------------------------------------
# restart
# ---------------------------------------

# Restart bspwm
super + alt + r
	bspc wm -r

# Quit bspwm
super + alt + q
	bspc quit

# ------------------------------------------
# BSPWM
# ------------------------------------------

# Close window
super + q
	bspc node -c

# Kill window process
super + shift + q
	bspc node -k

# Switch desktop layout
super + space
	bspc desktop -l next

# Switch window mode
super + m
	bspc node -t "~"{floating,tiled}

# Swap the current window with the largest window
super + g
	bspc node -s biggest.window

# Stretch/shrink the window to the middle of the screen on the left
super + alt + Left
    bspc node -z left -20 0 || bspc node -z right -20 0

# Stretch/shrink the window to the middle of the screen on the right
super + alt + Right
    bspc node -z right 20 0 || bspc node -z left 20 0

# ------------------------------------------
# WORK TABLES
# ------------------------------------------

# Switch to desktop (1-10)
super + {1-9,0}
	bspc desktop -f '^{1-9,10}'

# Move active window to desktop (1-10)
super + shift + {1-9,0}
	bspc node -d '^{1-9,10}'
