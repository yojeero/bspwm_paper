
# ------------------------------------
# run sxhkd via POSIX/Bash rules
# ------------------------------------

SXHKD_SHELL = /bin/bash

# ------------------------------------
# system
# ------------------------------------

super + Return
	alacritty

super + d
	rofi -show drun

super + w
	firefox

super + n
	thunar

Print
	xfce4-screenshooter -f

super + Print
    sleep 2; maim -u | tee "$HOME/Screen/pic_$(date +%F_%T).png" | xclip -selection clipboard -t image/png

# -------------------------------------
# POLYBAR
# -------------------------------------

# hide/show polybar
super + p
	polybar-msg cmd toggle

# restart polybar
super + shift + p
	pkill -USR1 polybar || ~/.config/polybar/launch.sh

# ---------------------------------------
# restart
# ---------------------------------------

# Перезагрузить конфигурацию sxhkd
super + e
	pkill -USR1 -x sxhkd

# Перезапустить bspwm
super + alt + r
	bspc wm -r

# Выйти из bspwm
super + alt + q
	bspc quit

# Перезагрузка ПК
super + ctrl + r
	sudo shutdown -r now

# Выключение ПК
super + ctrl + p
	sudo shutdown -h now

# ------------------------------------------
# BSPWM
# ------------------------------------------

# Закрыть окно (мягко)
super + x
	bspc node -c

# Уничтожить процесс окна (принудительно)
super + shift + q
	bspc node -k

# Переключение режима окна (Плавающее / Плиточное)
super + space
	bspc node -t "~"{floating,tiled}

# Переключение разметки рабочего стола (Tiled / Monocle)
super + m
	bspc desktop -l next

# Вернуть фокус на предыдущее окно или рабочий стол
super + {grave,Tab}
	bspc {node,desktop} -f last

# Отправить помеченное окно к предвыбранному свободному месту
super + y
	bspc node newest.marked.local -n newest.!automatic.local

# Поменять текущее окно местами с самым большим окном
super + g
	bspc node -s biggest.window

# Растянуть/сжать окно до середины экрана слева
super + alt + Left
    bspc node -z left -20 0 || bspc node -z right -20 0

# Растянуть/сжать окно до середины экрана справа
super + alt + Right
    bspc node -z right 20 0 || bspc node -z left 20 0

# ------------------------------------------
# РАБОЧИЕ СТОЛЫ
# ------------------------------------------

# Переключение на рабочий стол (1-10)
super + {1-9,0}
	bspc desktop -f '^{1-9,10}'

# Переместить активное окно на рабочий стол (1-10)
super + shift + {1-9,0}
	bspc node -d '^{1-9,10}'
